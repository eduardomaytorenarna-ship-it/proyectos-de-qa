{
  "info": {
    "name": "API Gestor de Tareas",
    "description": "Pruebas de contrato y de casos negativos para la API del gestor de tareas.\n\nEjecutable con Newman:\n\n    npm test\n\nRequiere la API corriendo en la URL de la variable baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('reporta estado ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.test('responde en menos de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
