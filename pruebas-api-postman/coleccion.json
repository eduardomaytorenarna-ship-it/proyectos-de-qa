    {
      "name": "Tareas",
      "item": [
        {
          "name": "POST /tasks - crea una tarea",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.test('devuelve el titulo enviado', () => pm.expect(t.title).to.eql('Tarea desde Postman'));",
                  "pm.test('done es booleano y arranca en false (BUG-006)', () => {",
                  "  pm.expect(t.done).to.be.a('boolean');",
                  "  pm.expect(t.done).to.eql(false);",
                  "});",
                  "pm.test('trae id y fecha de creacion', () => {",
                  "  pm.expect(t.id).to.be.a('number');",
                  "  pm.expect(t.created_at).to.be.a('string');",
                  "});",
                  "pm.environment.set('taskId', t.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Tarea desde Postman\"}"
            }
          }
        },
