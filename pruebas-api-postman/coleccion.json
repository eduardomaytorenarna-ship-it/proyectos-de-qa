        {
          "name": "GET /tasks - lista paginada (BUG-007)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('la respuesta trae la forma paginada', () => {",
                  "  pm.expect(b).to.have.all.keys('tasks', 'total', 'limit', 'offset');",
                  "  pm.expect(b.tasks).to.be.an('array');",
                  "});",
                  "pm.test('el total cuenta todas las tareas del usuario', () => pm.expect(b.total).to.be.at.least(b.tasks.length));",
                  "pm.test('respeta el limit pedido', () => pm.expect(b.limit).to.eql(10));",
                  "pm.test('todas las tareas traen done booleano', () => b.tasks.forEach(t => pm.expect(t.done).to.be.a('boolean')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
