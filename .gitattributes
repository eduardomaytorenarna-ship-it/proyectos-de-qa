# Normaliza los finales de linea al guardar en el repositorio, para que no
# dependan del sistema de quien haga commit.
* text=auto

# Los scripts de shell DEBEN quedar con LF: el CI los ejecuta en Linux, y con
# CRLF fallan con "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# Los archivos de Windows conservan CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binarios: sin conversion.
*.png binary
